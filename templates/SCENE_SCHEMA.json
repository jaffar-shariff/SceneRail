{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Masteraiskill Scene Timeline",
  "type": "object",
  "required": ["fps", "width", "height", "scenes"],
  "properties": {
    "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
    "width": { "type": "integer", "minimum": 16 },
    "height": { "type": "integer", "minimum": 16 },
    "title": { "type": "string" },
    "scenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "narration": {
      "type": "array",
      "items": { "$ref": "#/$defs/timedText" }
    },
    "captions": {
      "type": "array",
      "items": { "$ref": "#/$defs/timedText" }
    },
    "audio_cues": {
      "type": "array",
      "items": { "$ref": "#/$defs/audioCue" }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["id", "start_frame", "duration_frames", "type", "purpose"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "chapter": { "type": "string" },
        "start_frame": { "type": "integer", "minimum": 0 },
        "duration_frames": { "type": "integer", "minimum": 1 },
        "type": {
          "type": "string",
          "enum": ["title", "paper_card", "diagram", "chart", "timeline", "comparison", "map", "whiteboard", "isometric", "object_breakdown", "kinetic_type", "footage", "chapter_card", "custom"]
        },
        "purpose": { "type": "string", "minLength": 1 },
        "narration_segment_id": { "type": ["string", "null"] },
        "caption_segment_ids": { "type": "array", "items": { "type": "string" } },
        "transition_in": { "type": "string" },
        "transition_out": { "type": "string" },
        "asset_ids": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "timedText": {
      "type": "object",
      "required": ["id", "start_frame", "end_frame", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "audioCue": {
      "type": "object",
      "required": ["id", "start_frame", "end_frame", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["music", "sfx", "silence", "voiceover"] },
        "asset_id": { "type": ["string", "null"] },
        "gain_db": { "type": "number" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
